# Copy to .env and change secrets. Never commit .env.
DEBUG=false

POSTGRES_USER=medcenter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medcenter

# Used when running outside docker-compose (compose overrides these for the app container)
DATABASE_URL=postgresql+asyncpg://medcenter:change-me@localhost:5432/medcenter
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Organization details for the conclusion PDF header
ORG_NAME=
ORG_ADDRESS=
ORG_OGRN=
